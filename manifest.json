{
  "manifest_version": 3,
  "name": "DeepSeek Sidebar",
  "version": "1.0.0",
  "description": "在 Chrome 侧边栏使用 DeepSeek",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "Open DeepSeek Sidebar",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": ["sidePanel", "contextMenus", "declarativeNetRequest", "tabs", "scripting"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["chat.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
